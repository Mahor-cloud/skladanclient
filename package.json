{
    "name": "skladan",
    "version": "1.2.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint --fix . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:cov": "vitest run --coverage",
        "e2e": "playwright test --config=e2e/playwright.config.ts",
        "e2e:pages": "playwright test --config=e2e/playwright.config.ts e2e/tests/pages.spec.ts",
        "e2e:wcag": "playwright test --config=e2e/playwright.config.ts e2e/tests/wcag.spec.ts",
        "e2e:cross": "playwright test --config=e2e/playwright.config.ts e2e/tests/cross-company.spec.ts",
        "e2e:smoke": "playwright test --config=e2e/playwright.config.ts --project=desktop-light e2e/tests/pages.spec.ts",
        "e2e:report": "playwright show-report ../dev-snapshots/playwright-report"
    },
    "dependencies": {
        "@pdf-lib/fontkit": "^1.1.1",
        "@primevue/themes": "^4.2.4",
        "@tanstack/vue-query": "^5.64.2",
        "axios": "^1.16.0",
        "chart.js": "3.3.2",
        "js-cookie": "^3.0.5",
        "pdf-lib": "^1.17.1",
        "primeicons": "^7.0.0",
        "primevue": "^4.2.4",
        "vue": "^3.4.34",
        "vue-router": "^4.4.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.0",
        "@playwright/test": "^1.49.0",
        "@primevue/auto-import-resolver": "^4.2.4",
        "@rushstack/eslint-patch": "^1.8.0",
        "@vitejs/plugin-vue": "^5.0.5",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.19",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.23.0",
        "happy-dom": "^15.11.7",
        "postcss": "^8.4.40",
        "prettier": "^3.2.5",
        "sass": "^1.55.0",
        "tailwindcss": "^3.4.6",
        "tailwindcss-primeui": "^0.3.2",
        "unplugin-vue-components": "^0.27.3",
        "vite": "^5.3.1",
        "vite-plugin-pwa": "^0.21.1",
        "vitest": "^2.1.9",
        "workbox-precaching": "^7.3.0"
    }
}
